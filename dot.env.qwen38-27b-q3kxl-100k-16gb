# Qwen3.8 27B Q3_K_XL @ 100K — 16 GB VRAM agentic-coding profile
# ---------------------------------------------------------------------------
# TUNED FOR: NVIDIA GPU with 16 GB VRAM (e.g. RTX 4080 / 4090 / 5080), single user.
# Source: https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#   File: Qwen3.8-27B-UD-Q3_K_XL.gguf (~14 GB)
#   mmproj: mmproj-qwen38-27b-F16.gguf (885 MB) from same repo
# KV cache is split between GPU and system RAM (KV_OFFLOAD=1) to fit 100K context
# within 16 GB VRAM. q4_0 KV quantization keeps memory pressure manageable.
# Loaded via: PAQ_LLAMACPP_SERVER_ENV_FILE=dot.env.qwen38-27b-q3kxl-100k-16gb ./run-paq-llamacpp-server.sh
# Switch with: sudo bash scripts/switch-model.sh qwen38-16gb
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8080
MODEL_ALIAS=unsloth/Qwen3.8-27B-Q3,PAQ_LLAMACPP_SERVER
MODEL="$ROOT/models/Qwen3.8-27B-UD-Q3_K_XL.gguf"
MMPROJ="$ROOT/models/mmproj-qwen38-27b-F16.gguf"

GPU_LAYERS=all
CTX_SIZE=100000
BATCH_SIZE=1024
UBATCH_SIZE=256
THREADS=8
THREADS_BATCH=16
THREADS_HTTP=4
PARALLEL=1
KV_UNIFIED=0
KV_OFFLOAD=1
FLASH_ATTN=on
FIT=off

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
CACHE_RAM_MIB=50000
PROMPT_CACHE=1
CACHE_IDLE_SLOTS=0
CTX_CHECKPOINTS=20
WARMUP=0

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0
REASONING=auto
# Optional reliability guard: cap reasoning so tool calls never truncate.
# Leave empty for unrestricted; set e.g. 8192 if tool calls get cut off.
REASONING_BUDGET=
REASONING_BUDGET_MESSAGE=

# Chat template kwargs (built-in jinja template is used by default => faster
# than a file template; do NOT set LLAMA_CHAT_TEMPLATE_FILE for max decode speed).
LLAMA_CHAT_TEMPLATE_KWARGS='{"preserve_thinking":false,"reasoning_effort":"medium"}'
# LLAMA_CHAT_TEMPLATE_FILE="$ROOT/chat_templates/chat_template.jinja"

# MTP speculative decoding. SPEC_DRAFT_N_MAX=2 is a safe default for 16 GB VRAM
# (lower memory pressure than n_max=3). Tune up if you have headroom.
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=2
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
SPEC_DRAFT_NGL=auto
SPEC_DRAFT_CACHE_TYPE_K=q4_0
SPEC_DRAFT_CACHE_TYPE_V=q4_0
SPEC_DRAFT_BACKEND_SAMPLING=1

ENABLE_MMPROJ=1
# Vision enabled but projector kept on CPU (MMPROJ_OFFLOAD=0) to save VRAM.
# Set MMPROJ_OFFLOAD=1 if you have enough headroom and need faster image processing.
MMPROJ_OFFLOAD=0
IMAGE_MIN_TOKENS=1024

# Proxy / sampling configuration.
CLOUDFLARE_TIMEOUT_PROXY_MODE=stream
CLOUDFLARE_TIMEOUT_PROXY_BACKEND_PORT=18081
LLAMA_PROXY_FORCE_TEMPERATURE=1.0
LLAMA_PROXY_CLAMP_TEMPERATURE=
LLAMA_PROXY_CLAMP_TOP_P=0.95
LLAMA_PROXY_SET_TOP_K=20
LLAMA_PROXY_MIN_MAX_TOKENS=
LLAMA_PROXY_MAX_TOKENS_CTX_PCT=50
LLAMA_PROXY_STREAM_KEEPALIVE_MODE=reasoning
LLAMA_PROXY_STREAM_KEEPALIVE_TEXT=.
LLAMA_PROXY_NUDGE_AFTER_TOOL_RESULT=on
LLAMA_PROXY_CAPTURE_ENABLED=off

LLAMA_SERVER_API_KEY_FILE="$ROOT/api-keys.txt"
