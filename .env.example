# Qwen 3.8 27B llama.cpp launcher defaults
# Copy to .env and adjust locally. Do not put real secrets in this example file.
#
# This repo supports two model profiles — see the profile files for
# model-specific overrides. Switch between them with:
#   sudo bash scripts/switch-model.sh qwen38-16gb   # Qwen 3.8 27B Q3_K_XL, 100K ctx (16 GB VRAM)
#   sudo bash scripts/switch-model.sh qwen38-32gb   # Qwen 3.8 27B Q5_K_XL, 200K ctx (32 GB VRAM)
#
# Profiles:
#   dot.env.qwen38-27b-q3kxl-100k-16gb  — Qwen 3.8 27B, Q3_K_XL, 100K ctx, vision, MTP (16 GB VRAM)
#   dot.env.qwen38-27b-q5kxl-200k-32gb  — Qwen 3.8 27B, Q5_K_XL, 200K ctx, vision, MTP (32 GB VRAM)
#
# Model source: https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
# (Models are NOT included in this repo. Download the .gguf files into models/.)

HOST=0.0.0.0
PORT=8080
# PORT is the public/client listener. When the timeout proxy is enabled,
# llama-server uses PORT+1 (8081 here) unless the backend port is set below.
MODEL_ALIAS=unsloth/Qwen3.8-27B-Q5,PAQ_LLAMACPP_SERVER
MODEL="$ROOT/models/Qwen3.8-27B-UD-Q5_K_XL.gguf"

# Starting point for a 32 GB VRAM host (e.g. RTX 5090) with Qwen 3.8 27B Q5_K_XL.
# For 16 GB VRAM, use the qwen38-16gb profile instead (Q3_K_XL, 100K ctx).
GPU_LAYERS=all
CTX_SIZE=200000
BATCH_SIZE=1536
UBATCH_SIZE=384
THREADS=8
THREADS_BATCH=16
THREADS_HTTP=4

# Single-slot serving is strongly recommended for deterministic agentic/Copilot
# workloads. Multi-slot + unified-KV combinations have been observed to produce
# stale or repeated responses on this stack.
PARALLEL=1
KV_UNIFIED=0
KV_OFFLOAD=1
CTX_CHECKPOINTS=32

FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM_MIB=50000
PROMPT_CACHE=1
CACHE_IDLE_SLOTS=0
WARMUP=0
FIT=off

# Qwen 3.8 precise-coding/thinking-friendly sampling defaults.
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0
REASONING=auto
# Optional reliability guard: cap reasoning so tool calls never truncate.
# Leave empty for unrestricted; set e.g. 8192 if tool calls get cut off.
REASONING_BUDGET=
REASONING_BUDGET_MESSAGE=
# Chat template kwargs (built-in jinja template is used by default => faster
# than a file template; do NOT set LLAMA_CHAT_TEMPLATE_FILE for max decode speed).
LLAMA_CHAT_TEMPLATE_KWARGS='{"preserve_thinking":false,"reasoning_effort":"medium"}'
# LLAMA_CHAT_TEMPLATE_FILE="$ROOT/chat_templates/chat_template.jinja"

# MTP speculative decoding. SPEC_DRAFT_N_MAX=3 is the 200K-context optimum for
# agentic coding on 32 GB VRAM. Use n_max=2 for 16 GB VRAM profiles.
# Set SPEC_TYPE=off to disable quickly for debugging.
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
SPEC_DRAFT_NGL=auto
SPEC_DRAFT_CACHE_TYPE_K=q8_0
SPEC_DRAFT_CACHE_TYPE_V=q8_0
SPEC_DRAFT_BACKEND_SAMPLING=1
# SPEC_DRAFT_MODEL=/absolute/path/to/separate-mtp-draft.gguf

# Vision is enabled by default with the matching projector from the same repo.
ENABLE_MMPROJ=1
MMPROJ="$ROOT/models/mmproj-qwen38-27b-F16.gguf"
MMPROJ_OFFLOAD=1
IMAGE_MIN_TOKENS=1024

# Optional local auth/TLS. Keep real paths in .env only.
# LLAMA_SERVER_API_KEY_FILE=/absolute/path/to/api-keys.txt
# LLAMA_SERVER_SSL_KEY_FILE=/absolute/path/to/llamacpp.key.pem
# LLAMA_SERVER_SSL_CERT_FILE=/absolute/path/to/llamacpp.crt.pem

# Optional Cloudflare Tunnel connector managed by run-paq-llamacpp-server.sh / stop-paq-llamacpp-server.sh.
# If you install the host-wide systemd unit, make sure your user can run
# Docker Compose non-interactively before enabling CLOUDFLARED_*.
# In Cloudflare Zero Trust, point the published application at https://localhost:8080
# (or http://localhost:8080 if you disable local TLS). If you keep the local
# self-signed cert, enable "No TLS Verify" on the published application origin.
# CLOUDFLARED_TUNNEL_TOKEN=replace-with-your-remote-tunnel-token
# CLOUDFLARED_ENABLED=1
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.2.0
# CLOUDFLARED_PROTOCOL=auto
# CLOUDFLARED_LOGLEVEL=info

# Optional Cloudflare timeout proxy. This is separate from the tunnel connector above:
# - CLOUDFLARED_* publishes the hostname through Cloudflare Tunnel.
# - CLOUDFLARE_TIMEOUT_PROXY_* keeps long first-byte requests alive locally.
#
# Choose one mode:
#   off        = direct path to llama-server; best for local/direct use or strict clients
#   stream     = only for selected JSON inference requests with "stream": true
#   optimistic = also covers non-stream JSON inference requests, but late upstream
#                HTTP errors can only be returned inside the body/event after the
#                optimistic 200 has already started
#
# Enable the timeout proxy for streamed requests so the final chunk carries
# an OpenAI-compatible usage object (and costs/aliases) for client tracking.
CLOUDFLARE_TIMEOUT_PROXY_MODE=stream
# Optional explicit private backend; omit to use PORT+1 (8081 for PORT=8080).
# CLOUDFLARE_TIMEOUT_PROXY_BACKEND_PORT=8082
# Heartbeat interval in seconds for the timeout proxy (default 15).
CLOUDFLARE_TIMEOUT_PROXY_HEARTBEAT_SECONDS=15
# Outgoing-request stabilization for Copilot clients.
# Captured VS Code Copilot traffic sends temperature=1, top_p=1 by default;
# clamp back to Qwen 3.8-recommended sampling for tool-call stability.
LLAMA_PROXY_CLAMP_TEMPERATURE=
LLAMA_PROXY_CLAMP_TOP_P=0.95
LLAMA_PROXY_SET_TOP_K=20
# Optional: only raise an EXISTING too-small max_tokens/max_completion_tokens.
# It never adds a cap when the client sends none (VS Code Copilot usually sends none).
LLAMA_PROXY_MIN_MAX_TOKENS=
# Output token ceiling: cap max_tokens at this percentage of CTX_SIZE.
# Unlike MIN_MAX_TOKENS, this DOES impose a limit when the client sends none.
# Set to 0 or leave empty to disable. Default 50 = 50% of context window.
LLAMA_PROXY_MAX_TOKENS_CTX_PCT=50
# Keep-alive style for streaming clients waiting on a busy single slot:
#   comment = SSE ': keep-alive' comment (default; keeps socket alive only)
#   data      = empty-delta OpenAI chunk (real SSE event; may not reset client TTFT)
#   reasoning = real reasoning_content delta per interval (best chance to keep a
#               strict client like Copilot from silently giving up while queued;
#               shown as thinking, never pollutes the answer or tool calls)
LLAMA_PROXY_STREAM_KEEPALIVE_MODE=reasoning
# Reasoning text emitted per keep-alive interval in reasoning mode (default '.').
LLAMA_PROXY_STREAM_KEEPALIVE_TEXT=.
# Qwen 3.8 tool-result continuation nudge (critical).
# After a role=tool result, Qwen 3.8 can intermittently stop with empty content
# or reasoning-only output. This injects a hidden continuation message that
# forces the model to emit either a tool_call or visible assistant content.
# See QWEN38_RELIABILITY_GUIDE.md §3 for details.
LLAMA_PROXY_NUDGE_AFTER_TOOL_RESULT=on
# The nudge text itself (must match the proxy built-in default unless customized).
LLAMA_PROXY_TOOL_RESULT_NUDGE_TEXT="Continue after the latest tool result. Do not stop in the reasoning/thinking channel. Before finishing, you must emit either a valid tool_call or visible assistant content. If any planned work remains, call the next appropriate tool now. Do not merely describe the next step in reasoning."
# Optional request capture for replay/debug. OFF by default.
LLAMA_PROXY_CAPTURE_ENABLED=off
# Only used when capture is enabled.
# LLAMA_PROXY_CAPTURE_DIR="$ROOT/captures"

# Optional CSV cost logging directory (requests.csv + daily-summary.csv).
# COST_LOG_DIR="$ROOT/cost-logs"
