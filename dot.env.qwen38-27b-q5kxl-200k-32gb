# Qwen3.8 27B Q5_K_XL @ 200K — 32 GB VRAM agentic-coding profile
# ---------------------------------------------------------------------------
# TUNED FOR: NVIDIA GPU with 32 GB VRAM (e.g. RTX 5090), single user.
# Source: https://huggingface.co/unsloth/Qwen3.8-27B-GGUF
#   File: Qwen3.8-27B-UD-Q5_K_XL.gguf (20 GB)
#   mmproj: mmproj-qwen38-27b-F16.gguf (885 MB) from same repo
# Everything fits entirely in VRAM (~30.1 GB / 32 GB used at MTP n_max=3,
# ~2.1 GB headroom). Single-concurrent-user.
# Loaded via: PAQ_LLAMACPP_SERVER_ENV_FILE=dot.env.qwen38-27b-q5kxl-200k-32gb ./run-paq-llamacpp-server.sh
# Switch with: sudo bash scripts/switch-model.sh qwen38-32gb
# ---------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8080
MODEL_ALIAS=unsloth/Qwen3.8-27B-Q5,PAQ_LLAMACPP_SERVER
MODEL="$ROOT/models/Qwen3.8-27B-UD-Q5_K_XL.gguf"
MMPROJ="$ROOT/models/mmproj-qwen38-27b-F16.gguf"

GPU_LAYERS=all
CTX_SIZE=200000
BATCH_SIZE=1536
UBATCH_SIZE=384
THREADS=8
THREADS_BATCH=16
THREADS_HTTP=4
PARALLEL=1
KV_UNIFIED=0
KV_OFFLOAD=1
FLASH_ATTN=on
FIT=off

CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM_MIB=50000
PROMPT_CACHE=1
CACHE_IDLE_SLOTS=0
CTX_CHECKPOINTS=32
WARMUP=0

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0
REASONING=auto
# Optional reliability guard: cap reasoning so tool calls never truncate.
# Leave empty for unrestricted; set e.g. 8192 if tool calls get cut off.
REASONING_BUDGET=
REASONING_BUDGET_MESSAGE=

# Chat template kwargs (built-in jinja template is used by default => faster
# than a file template; do NOT set LLAMA_CHAT_TEMPLATE_FILE for max decode speed).
LLAMA_CHAT_TEMPLATE_KWARGS='{"preserve_thinking":false,"reasoning_effort":"medium"}'
# LLAMA_CHAT_TEMPLATE_FILE="$ROOT/chat_templates/chat_template.jinja"

# MTP speculative decoding. SPEC_DRAFT_N_MAX=3 is the 50K-context optimum for
# agentic coding (decode 113.5 tok/s vs 100.4 @ n2, 70% acceptance, fits VRAM).
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_N_MIN=0
SPEC_DRAFT_P_MIN=0.0
SPEC_DRAFT_NGL=auto
SPEC_DRAFT_CACHE_TYPE_K=q8_0
SPEC_DRAFT_CACHE_TYPE_V=q8_0
SPEC_DRAFT_BACKEND_SAMPLING=1

ENABLE_MMPROJ=1
# Vision on + offloaded to GPU is the default for multimodal agent use
# (screenshots). For pure text-only agent work you can set MMPROJ_OFFLOAD=0 to
# free ~0.9 GB VRAM and gain ~1-2 tok/s decode (within noise on the sweep).
MMPROJ_OFFLOAD=1
IMAGE_MIN_TOKENS=1024

# Proxy / sampling configuration (production parity with the base .env).
CLOUDFLARE_TIMEOUT_PROXY_MODE=stream
# Backend (llama-server) port. Default is PORT+1 (=8081), which collides with the
# jakikomputer_phpmyadmin Docker container. Use a totally different port.
CLOUDFLARE_TIMEOUT_PROXY_BACKEND_PORT=18081
LLAMA_PROXY_FORCE_TEMPERATURE=1.0
LLAMA_PROXY_CLAMP_TEMPERATURE=
LLAMA_PROXY_CLAMP_TOP_P=0.95
LLAMA_PROXY_SET_TOP_K=20
LLAMA_PROXY_MIN_MAX_TOKENS=
LLAMA_PROXY_MAX_TOKENS_CTX_PCT=50
LLAMA_PROXY_STREAM_KEEPALIVE_MODE=reasoning
LLAMA_PROXY_STREAM_KEEPALIVE_TEXT=.
LLAMA_PROXY_NUDGE_AFTER_TOOL_RESULT=on
LLAMA_PROXY_CAPTURE_ENABLED=off

LLAMA_SERVER_API_KEY_FILE="$ROOT/api-keys.txt"
